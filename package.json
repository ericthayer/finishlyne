{
  "name": "finishlyne",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "Personal command center for projects born from agentic development.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node design/build-tokens.mjs src/ui/tokens/tokens.css",
    "check": "npm run typecheck && npm run test && npm run build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.56.0",
    "@types/node": "22.20.5",
    "playwright-core": "1.56.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  },
  "dependencies": {
    "@supabase/auth-js": "2.117.1",
    "@supabase/postgrest-js": "2.117.1"
  }
}
